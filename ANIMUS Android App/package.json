{
  "name": "animus-android",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web-sign-in": "node scripts/build-web-sign-in.mjs",
    "build": "node scripts/build.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "test": "node --test tests/*.test.mjs",
    "preview": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "8.5.2",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@fullcalendar/core": "6.1.22",
    "@fullcalendar/daygrid": "6.1.22",
    "@fullcalendar/interaction": "6.1.22",
    "@fullcalendar/list": "6.1.22",
    "@fullcalendar/timegrid": "6.1.22",
    "firebase": "12.19.0",
    "jose": "6.2.12",
    "lucide": "^0.468.0"
  },
  "overrides": {
    "@firebase/firestore": { "@grpc/grpc-js": "1.13.6" }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "esbuild": "^0.25.0"
  }
}
